{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "uv run uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}",
    "build": "uv run python -m compileall -q app",
    "start": "uv run uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}",
    "typecheck": "uv run python -m compileall -q app tests",
    "test": "uv run pytest -q"
  }
}
